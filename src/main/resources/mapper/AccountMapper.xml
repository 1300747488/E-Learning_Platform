<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ray.elearning_platform.mapper.AccountMapper">

    <!-- Account 实体映射 -->
    <resultMap id="AccountResultMap" type="com.ray.elearning_platform.entity.Account">
        <id property="accountId" column="account_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="fullName" column="full_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- UserListResp 映射 -->
    <resultMap id="UserListRespResultMap" type="com.ray.elearning_platform.resp.UserListResp">
        <id property="accountId" column="account_id"/>
        <result property="username" column="username"/>
        <result property="fullName" column="full_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 新增账户 -->
    <insert id="insertAccount"
            parameterType="com.ray.elearning_platform.entity.Account"
            useGeneratedKeys="true"
            keyProperty="accountId">
        INSERT INTO account (
        username,
        password,
        full_name,
        email,
        phone,
        avatar,
        role,
        status
        )
        VALUES (
        #{username},
        #{password},
        #{fullName},
        #{email},
        #{phone},
        #{avatar},
        #{role},
        #{status}
        )
    </insert>

    <!-- 根据用户名查询账户 -->
    <select id="selectByUsername" resultMap="AccountResultMap">
        SELECT
        account_id,
        username,
        password,
        full_name,
        email,
        phone,
        avatar,
        role,
        status,
        created_at,
        updated_at
        FROM account
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 根据账户ID查询账户 -->
    <select id="selectById" resultMap="AccountResultMap">
        SELECT
        account_id,
        username,
        password,
        full_name,
        email,
        phone,
        avatar,
        role,
        status,
        created_at,
        updated_at
        FROM account
        WHERE account_id = #{accountId}
        LIMIT 1
    </select>

    <!-- 修改个人资料 -->
    <update id="updateProfile" parameterType="com.ray.elearning_platform.entity.Account">
        UPDATE account
        SET
        full_name = #{fullName},
        email = #{email},
        phone = #{phone},
        avatar = #{avatar},
        updated_at = NOW()
        WHERE account_id = #{accountId}
    </update>

    <!-- 修改账户状态 -->
    <update id="updateStatus">
        UPDATE account
        SET
        status = #{status},
        updated_at = NOW()
        WHERE account_id = #{accountId}
    </update>

    <!-- 查询用户列表 -->
    <select id="selectUserList" resultMap="UserListRespResultMap">
        SELECT
        account_id,
        username,
        full_name,
        email,
        phone,
        avatar,
        role,
        status,
        created_at
        FROM account
        WHERE 1 = 1

        <if test="role != null and role != ''">
            AND role = #{role}
        </if>

        <if test="keyword != null and keyword != ''">
            AND (
            username LIKE CONCAT('%', #{keyword}, '%')
            OR full_name LIKE CONCAT('%', #{keyword}, '%')
            OR email LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>

        ORDER BY created_at DESC
    </select>

</mapper>
